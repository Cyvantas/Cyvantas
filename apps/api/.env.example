# CYVANTAS Security Lab API — local configuration
# Copy to .env for local overrides. NEVER commit a real .env (see .gitignore).
# Do not put real credentials in this example file.

# Node environment: development | test | production
# In production, DATABASE_URL is required and cookies are marked Secure.
NODE_ENV=development

# Port the API listens on.
PORT=8787

# Bind address. Defaults to loopback so the API is NOT reachable off-host.
# Do not set 0.0.0.0 unless you understand the exposure.
HOST=127.0.0.1

# Allowed CORS origin(s). Comma-separate multiple origins.
# Never use "*" — the API rejects wildcard CORS by design.
#   In PRODUCTION this is MANDATORY and fail-closed: it must be set explicitly,
#   every entry must be an absolute https:// URL, and loopback hosts
#   (localhost / 127.0.0.1 / ::1) are rejected. Outside production it falls back
#   to http://localhost:5173.
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string (Prisma). Use a placeholder here; put the real
# value only in your local .env, never in git.
#   If DATABASE_URL is UNSET, the API falls back to an in-memory store
#   (development/test convenience only — data is lost on restart, sessions are
#   per-process, and it is NOT for production).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/cyvantas

# OPTIONAL — Redis-compatible connection string for SHARED rate-limit /
# detection state across API instances. Provider-neutral: no Redis client ships
# with this repo and no provider is selected. A value here is validated (must be
# redis:// or rediss://); the deployment boundary (src/server.ts) then builds a
# Redis-backed store from an injected client. If you set this WITHOUT wiring a
# client factory, boot is refused fail-closed (never a silent per-process
# fallback). Required only for a MULTI-INSTANCE deployment; a single instance may
# leave it unset. Put the real value only in your platform's secret manager.
#   See docs/PRODUCTION-INFRASTRUCTURE.md → Redis.
# REDIS_URL=rediss://USER:PASSWORD@HOST:6379

# Session cookie name.
SESSION_COOKIE_NAME=cyv_session

# Session lifetime in seconds (default 604800 = 7 days). Range: 60..7776000.
SESSION_TTL=604800

# --- Environment-service policy (Phase 9) ----------------------------------
# All values are server-authoritative; clients can never exceed them. Phase 9
# provisions NO real sandbox/container — these bound the lifecycle records only.

# Max concurrently-live environments per user (REQUESTED..RESETTING). Default 3.
MAX_ACTIVE_ENVIRONMENTS=3

# Max retained (non-destroyed) environments per user. Must be >= MAX_ACTIVE.
# Default 25.
MAX_TOTAL_ENVIRONMENTS=25

# Idle TTL in minutes. A sliding window refreshed by activity/touch. Default 60.
ENVIRONMENT_TTL_MINUTES=60

# Absolute lifetime cap in minutes from creation; a client can NEVER extend
# past this via touch. Must be >= ENVIRONMENT_TTL_MINUTES. Default 240.
MAX_ENVIRONMENT_LIFETIME_MINUTES=240

# --- Monitoring + abuse detection (Phase 13) -------------------------------
# The API emits structured, redaction-safe security events and runs observe-only
# detection. Detection NEVER blocks a request (the rate limiter denies); it only
# escalates a single "…_ABUSE_SUSPECTED" event when a fixed-window threshold is
# crossed. Thresholds sit ABOVE the per-user rate limits so a single well-behaved
# user never trips an alert. See docs/MONITORING.md and docs/ABUSE-CONTROLS.md.

# Emit security events to stdout as JSON lines. Defaults true except under test.
SECURITY_EVENT_LOG=true

# Repeated failed-auth occurrences (per ip / per user) in a 15-min window before
# AUTH_ABUSE_SUSPECTED is emitted. Default 8.
SECURITY_FAILED_AUTH_THRESHOLD=8

# Challenge submissions per user in a 1-min window before
# CHALLENGE_SUBMISSION_ABUSE_SUSPECTED. Default 40.
SECURITY_SUBMISSION_THRESHOLD=40

# Environment create/reset activity per user in a 1-min window before
# ENVIRONMENT_ABUSE_SUSPECTED. Default 40.
SECURITY_ENV_ACTIVITY_THRESHOLD=40

# Invalid/expired session presentations per ip in a 5-min window before
# INVALID_SESSION_ABUSE_SUSPECTED. Default 12.
SECURITY_INVALID_SESSION_THRESHOLD=12

# Total requests per ip in a 1-min window before REQUEST_BURST_SUSPECTED.
# Default 600.
SECURITY_REQUEST_BURST_THRESHOLD=600

