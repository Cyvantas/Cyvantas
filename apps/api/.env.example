# CYVANTAS Security Lab API — local configuration
# Copy to .env for local overrides. NEVER commit a real .env (see .gitignore).
# Do not put real credentials in this example file.

# Node environment: development | test | production
# In production, DATABASE_URL is required and cookies are marked Secure.
NODE_ENV=development

# Port the API listens on.
PORT=8787

# Bind address. Defaults to loopback so the API is NOT reachable off-host.
# Do not set 0.0.0.0 unless you understand the exposure.
HOST=127.0.0.1

# Allowed CORS origin(s). Comma-separate multiple origins.
# Never use "*" — the API rejects wildcard CORS by design.
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string (Prisma). Use a placeholder here; put the real
# value only in your local .env, never in git.
#   If DATABASE_URL is UNSET, the API falls back to an in-memory store
#   (development/test convenience only — data is lost on restart, sessions are
#   per-process, and it is NOT for production).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/cyvantas

# Session cookie name.
SESSION_COOKIE_NAME=cyv_session

# Session lifetime in seconds (default 604800 = 7 days). Range: 60..7776000.
SESSION_TTL=604800

# --- Environment-service policy (Phase 9) ----------------------------------
# All values are server-authoritative; clients can never exceed them. Phase 9
# provisions NO real sandbox/container — these bound the lifecycle records only.

# Max concurrently-live environments per user (REQUESTED..RESETTING). Default 3.
MAX_ACTIVE_ENVIRONMENTS=3

# Max retained (non-destroyed) environments per user. Must be >= MAX_ACTIVE.
# Default 25.
MAX_TOTAL_ENVIRONMENTS=25

# Idle TTL in minutes. A sliding window refreshed by activity/touch. Default 60.
ENVIRONMENT_TTL_MINUTES=60

# Absolute lifetime cap in minutes from creation; a client can NEVER extend
# past this via touch. Must be >= ENVIRONMENT_TTL_MINUTES. Default 240.
MAX_ENVIRONMENT_LIFETIME_MINUTES=240

