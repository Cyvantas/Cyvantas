// CYVANTAS Security Lab — database schema (Phase 8: auth + database foundation).
//
// PostgreSQL relational schema. UUID identifiers, created/updated timestamps,
// normalized roles, server-side opaque sessions (only token *hashes* stored),
// account-scoped progress, and a security audit log.
//
// This schema is portable and authoritative. Engine generation / migration
// must run on a Prisma-supported host with PostgreSQL reachable via
// DATABASE_URL (see apps/api/docs/AUTH.md → Local development).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  USER
  AUTHOR
  ADMIN
  SYSTEM
}

enum AuditEvent {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  REGISTER
  SESSION_REVOKED
  ROLE_CHANGED
  ENVIRONMENT_CREATED
  ENVIRONMENT_START_REQUESTED
  ENVIRONMENT_READY
  ENVIRONMENT_ACTIVATED
  ENVIRONMENT_RESET_REQUESTED
  ENVIRONMENT_STOP_REQUESTED
  ENVIRONMENT_DESTROY_REQUESTED
  ENVIRONMENT_DESTROYED
  ENVIRONMENT_TIMEOUT
  ENVIRONMENT_FAILED
  SANDBOX_PROVISION_REQUESTED
  SANDBOX_PROVISION_REJECTED
  SANDBOX_PROVISION_STARTED
  SANDBOX_READY
  SANDBOX_START_REQUESTED
  SANDBOX_STARTED
  SANDBOX_STOP_REQUESTED
  SANDBOX_STOPPED
  SANDBOX_RESET_REQUESTED
  SANDBOX_RESET
  SANDBOX_DESTROY_REQUESTED
  SANDBOX_DESTROYED
  SANDBOX_RUNTIME_UNAVAILABLE
  SANDBOX_POLICY_REJECTED
  SANDBOX_TIMEOUT
}

// Environment lifecycle (control-plane) status. Kept deliberately separate from
// runtimeStatus: this describes the environment record's lifecycle, NOT whether
// a sandbox/container is running.
enum EnvironmentStatus {
  REQUESTED
  PROVISIONING
  READY
  ACTIVE
  TIMEOUT
  RESETTING
  DESTROYING
  DESTROYED
  FAILED
}

// Runtime (data-plane) status — the future contract for an actual sandbox
// runtime. In Phase 9 no runtime exists, so this stays NOT_PROVISIONED; the
// other values are reserved for the Phase 10 runtime provider.
enum EnvironmentRuntimeStatus {
  NOT_PROVISIONED
  STARTING
  RUNNING
  STOPPING
  STOPPED
  FAILED
}

enum EnvironmentType {
  CHALLENGE
  MISSION
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  displayName  String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles             UserRole[]
  sessions          Session[]
  challengeProgress ChallengeProgress[]
  learningProgress  LearningProgress[]
  missionProgress   MissionProgress[]
  auditLogs         AuditLog[]
  environments      Environment[]

  @@index([isActive])
  @@map("users")
}

model Role {
  id        String     @id @default(uuid()) @db.Uuid
  name      RoleName   @unique
  createdAt DateTime   @default(now())
  users     UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model ChallengeProgress {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  challengeSlug String
  status        String    @default("in_progress")
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeSlug])
  @@index([userId])
  @@map("challenge_progress")
}

model LearningProgress {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  learningPathSlug String
  lessonSlug       String?
  status           String    @default("in_progress")
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, learningPathSlug])
  @@index([userId])
  @@map("learning_progress")
}

model MissionProgress {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  missionSlug String
  status      String    @default("in_progress")
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, missionSlug])
  @@index([userId])
  @@map("mission_progress")
}

model AuditLog {
  id        String     @id @default(uuid()) @db.Uuid
  event     AuditEvent
  userId    String?    @db.Uuid
  ip        String?
  userAgent String?
  createdAt DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([event])
  @@index([createdAt])
  @@map("audit_logs")
}

// A per-user training environment for a challenge or mission.
//
// Phase 9 persists the lifecycle only — it NEVER creates a container, sandbox,
// or process. `status` is the control-plane lifecycle; `runtimeStatus` is the
// (future) data-plane state, which stays NOT_PROVISIONED until a real runtime
// provider is attached in Phase 10. Exactly one of challengeSlug/missionSlug is
// set, matching `type`. Slugs are validated against the Lab catalog before an
// Environment is created; arbitrary values are rejected at the service layer.
model Environment {
  id                    String                   @id @default(uuid()) @db.Uuid
  userId                String                   @db.Uuid
  type                  EnvironmentType
  challengeSlug         String?
  missionSlug           String?
  status                EnvironmentStatus        @default(REQUESTED)
  runtimeStatus         EnvironmentRuntimeStatus @default(NOT_PROVISIONED)
  requestedAt           DateTime                 @default(now())
  provisioningStartedAt DateTime?
  readyAt               DateTime?
  startedAt             DateTime?
  lastActivityAt        DateTime                 @default(now())
  expiresAt             DateTime
  timeoutAt             DateTime?
  destroyedAt           DateTime?
  failureCode           String?
  failureMessage        String?
  // Reserved for the Phase 10 runtime provider (e.g. provider handle/refs).
  // Never contains secrets and is never exposed through the public DTO.
  metadata              Json?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([userId, status])
  @@index([challengeSlug])
  @@index([missionSlug])
  @@map("environments")
}
