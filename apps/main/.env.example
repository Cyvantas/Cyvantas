# CYVANTAS — main website environment configuration
# Copy this file to `.env.local` and fill in real values there (never commit it).

# ── Client-side (bundled into the browser) ──────────────────────────────────
# VITE_* variables are PUBLIC. Only put non-secret values here.

# URL of the backend/serverless function that receives contact submissions.
# This URL is public by design (the browser calls it). It is NOT a secret.
# Leave unset to keep the "email us directly" fallback on the contact form.
# Examples:
#   VITE_CONTACT_ENDPOINT=/api/contact
#   VITE_CONTACT_ENDPOINT=https://your-domain.example/api/contact
VITE_CONTACT_ENDPOINT=

# ── Server-side (serverless function only) ──────────────────────────────────
# The email-service secrets below MUST live in your serverless platform's
# environment (Vercel/Netlify/Cloudflare/etc.), NOT in this file and NEVER with
# a VITE_ prefix — a VITE_ prefix would bundle them into the client.
# Listed here only as documentation of the names the backend will expect:
#
#   CONTACT_EMAIL_API_KEY   # API key for the chosen email provider
#   CONTACT_EMAIL_TO        # destination inbox for assessment requests
#   CONTACT_EMAIL_FROM      # verified sender address
